# ══════════════════════════════════════════════════════════
# CIRO Backend — Environment Configuration (EXAMPLE)
# Copy this file:  cp .env.example .env
# Then fill in your actual API keys.
# ══════════════════════════════════════════════════════════

APP_NAME=CIRO
DEBUG=true
HOST=0.0.0.0
PORT=8000

# (REQUIRED) https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# (REQUIRED) https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# (OPTIONAL) https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your-openweather-api-key-here

# (OPTIONAL) https://developer.tomtom.com/
TOMTOM_API_KEY=your-tomtom-api-key-here

# (OPTIONAL) Live ingestion toggle
USE_LIVE_APIS=false

# (OPTIONAL) Signal hygiene / stress-test controls
SIGNAL_DEDUP_WINDOW_SECONDS=180
SIGNAL_MAX_AGE_MINUTES=120

# (OPTIONAL) Live weather anchor (OpenWeatherMap)
LIVE_WEATHER_LAT=33.6844
LIVE_WEATHER_LON=73.0479
LIVE_WEATHER_LABEL=Islamabad
